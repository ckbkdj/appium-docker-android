{
  "name": "semantic-mobile-agent",
  "description": "语义控制 Android 云手机；普通动作自动执行，付款/下单/最终叫车/发消息等动作要求二次确认。",
  "transport": {
    "type": "mcp-stdio",
    "command": "semantic-mobile-mcp",
    "env": {
      "SMA_DEFAULT_DEVICE": "${ANDROID_DEVICE}",
      "SMA_APPIUM_URL": "${APPIUM_URL}",
      "SMA_LLM_BASE_URL": "${OPENAI_BASE_URL}",
      "SMA_LLM_API_KEY": "${OPENAI_API_KEY}",
      "SMA_LLM_MODEL": "${OPENAI_MODEL}"
    }
  },
  "tools": [
    "mobile_execute",
    "mobile_plan",
    "mobile_task_status",
    "mobile_confirm",
    "mobile_devices"
  ],
  "device_selection": {
    "strategy": "parent-agent",
    "accepted_examples": ["emulator-5554", "emul-5554", "10.0.0.8:5555"]
  }
}
