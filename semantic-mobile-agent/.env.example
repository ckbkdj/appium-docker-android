# Service
SMA_HOST=0.0.0.0
SMA_PORT=8787
SMA_LOG_LEVEL=INFO
SMA_DATA_DIR=./data

# Device / drivers
SMA_ADB_PATH=adb
SMA_DEFAULT_DEVICE=
SMA_APPIUM_URL=http://127.0.0.1:4723
SMA_APPIUM_ENABLED=true
SMA_BRIDGE_ENABLED=true
SMA_BRIDGE_SOCKET=semantic_mobile_agent
SMA_BRIDGE_PORT_BASE=17300
SMA_BRIDGE_TOKEN=
SMA_ACTION_SETTLE_MS=180
SMA_UI_CACHE_TTL_MS=120

# Any OpenAI-compatible endpoint. Leave empty to use deterministic local policies only.
SMA_LLM_BASE_URL=
SMA_LLM_API_KEY=
SMA_LLM_MODEL=
SMA_LLM_TIMEOUT_S=20
SMA_LLM_MAX_REPLANS=3

# Risk controls: final payment/order/ride/message/delete actions stop for confirmation by default.
SMA_REQUIRE_CONFIRMATION=true
SMA_ALLOW_UNSAFE=false
